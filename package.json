{
  "name": "twinslop-hands",
  "version": "1.0.0",
  "private": true,
  "description": "Телефонный контроллер: два стика = две руки (VR-совместимый вывод через HTTP/SSE)",
  "main": "server.js",
  "scripts": {
    "build:game": "esbuild src/game/main.js --bundle --format=iife --minify --target=es2019 --outfile=web/game.bundle.js",
    "build:apk": "esbuild src/apk/main.js --bundle --format=iife --minify --target=es2019 --outfile=web/apk.bundle.js",
    "build:apps": "esbuild src/apps/main.js --bundle --format=iife --minify --target=es2019 --outfile=web/apps.bundle.js",
    "build:ape": "esbuild src/ape/main.js --bundle --format=iife --minify --target=es2019 --outfile=web/ape.bundle.js",
    "build:settings": "esbuild src/settings/main.js --bundle --format=iife --minify --target=es2019 --outfile=web/settings.bundle.js",
    "build": "npm run build:game && npm run build:apk && npm run build:apps && npm run build:ape && npm run build:settings",
    "test": "node test/smoke.mjs && node test/apk.mjs && node test/apps.mjs && node test/ape.mjs && node test/settings.mjs",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.169.0"
  }
}